{
  "name": "@sudobility/shapeshyft_engine",
  "version": "1.0.14",
  "description": "Stateless LLM structured-output engine shared by ShapeShyft and ShapeRouter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test:unit": "tsc -p tsconfig.esm.json && vitest run",
    "test:watch": "vitest",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "keywords": [
    "llm",
    "structured-output",
    "shapeshyft"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "dependencies": {
    "@sudobility/types": "^1.9.78"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.21.0",
    "groq-sdk": "^0.37.0",
    "openai": "^4.77.0",
    "sharp": "^0.35.4"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/generative-ai": {
      "optional": true
    },
    "groq-sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "~0.39.0",
    "@google/generative-ai": "~0.21.0",
    "@types/bun": "latest",
    "@types/node": "~24.19.2",
    "@types/sharp": "~0.32.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-plugin-import": "~2.32.0",
    "groq-sdk": "~0.37.0",
    "openai": "~4.104.0",
    "prettier": "~3.9.10",
    "sharp": "~0.35.4",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/shapeshyft_engine.git"
  }
}
